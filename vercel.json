{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/qld-gauges.ts": {
      "maxDuration": 60
    },
    "api/news-ingest.ts": {
      "maxDuration": 60
    },
    "api/news.ts": {
      "maxDuration": 60
    },
    "api/[endpoint].ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path(.+)/index.html",
      "destination": "/:path/",
      "permanent": true
    },
    {
      "source": "/:page(about|privacy|contact|stations|lines|places)",
      "destination": "/:page/",
      "permanent": true
    },
    {
      "source": "/:dir(stations|lines|places)/:slug([a-z0-9-]+)",
      "destination": "/:dir/:slug/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/mcp",
      "destination": "/.well-known/mcp.json"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/status",
      "destination": "/index.html"
    },
    {
      "source": "/kiosk/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/translink-rt/:path*",
      "destination": "https://gtfsrt.api.translink.com.au/api/realtime/:path*"
    },
    {
      "source": "/qfd-bushfires",
      "destination": "https://publiccontent-gis-psba-qld-gov-au.s3.amazonaws.com/content/Feeds/BushfireCurrentIncidents/bushfireAlert.json"
    },
    {
      "source": "/qld-warnings",
      "destination": "https://publiccontent-qld-alerts.s3.ap-southeast-2.amazonaws.com/content/Feeds/StormFloodCycloneWarnings/StormWarnings.json"
    },
    {
      "source": "/air-quality",
      "destination": "https://apps.des.qld.gov.au/air-quality/xml/feed.php?category=1&region=ALL"
    },
    {
      "source": "/qld-gauges",
      "destination": "/api/qld-gauges"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
