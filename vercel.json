{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/mcp",
      "destination": "/.well-known/mcp.json"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/kiosk/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/translink-rt/:path*",
      "destination": "https://gtfsrt.api.translink.com.au/api/realtime/:path*"
    },
    {
      "source": "/qfd-bushfires",
      "destination": "https://publiccontent-gis-psba-qld-gov-au.s3.amazonaws.com/content/Feeds/BushfireCurrentIncidents/bushfireAlert.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
